    if test "$compile_mode" = "dso" ; then
        BUILD_rds_resfile_DSO=1
    else
        BUILD_rds_resfile_DSO=0
    fi
     if test "$BUILD_rds_resfile_DSO" = "1"; then
  OMPI_BUILD_rds_resfile_DSO_TRUE=
  OMPI_BUILD_rds_resfile_DSO_FALSE='#'
else
  OMPI_BUILD_rds_resfile_DSO_TRUE='#'
  OMPI_BUILD_rds_resfile_DSO_FALSE=
