                              MCA_opal_FRAMEWORK_COMPONENT_STATIC_SUBDIRS="$MCA_opal_FRAMEWORK_COMPONENT_STATIC_SUBDIRS \$(MCA_memcpy_STATIC_SUBDIRS)"
