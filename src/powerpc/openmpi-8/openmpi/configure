	    *\'*) subdir_arg=`echo "$subdir_arg" | sed "s/'/'\\\\\\\\''/g"` ;;
	    esac
	    subdirs_args="$subdirs_args '$subdirs_arg'"
	    ;;
	esac
    fi
done

