    # set the AM_CONDITIONAL on how we should build
    if test "$compile_mode" = "dso"; then
  BUILD_errmgr_bproc_DSO=1
else
  BUILD_errmgr_bproc_DSO=0
fi

     if test "$BUILD_errmgr_bproc_DSO" = "1"; then
  OMPI_BUILD_errmgr_bproc_DSO_TRUE=
  OMPI_BUILD_errmgr_bproc_DSO_FALSE='#'
else
