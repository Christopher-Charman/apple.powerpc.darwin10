*** does not appear to support direct calling.
*** Aborting" >&5
echo "$as_me: error: *** ${framework} component ${component} was supposed to be direct-called, but
*** does not appear to support direct calling.
*** Aborting" >&2;}
   { (exit 1); exit 1; }; }
