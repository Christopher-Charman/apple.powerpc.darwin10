        ompi_ac_size_fn=size
    elif test "$ompi_cv_f77_external_symbol" = "upper case" ; then
        ompi_ac_size_fn=SIZE
    else
        { { echo "$as_me:$LINENO: error: unknown naming convention: $ompi_cv_f77_external_symbol" >&5
