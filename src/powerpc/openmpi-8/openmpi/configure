    if test "$with_sds" = "slurm" ; then
        { echo "$as_me:$LINENO: WARNING: MCA component \"slurm\" failed to configure properly" >&5
echo "$as_me: WARNING: MCA component \"slurm\" failed to configure properly" >&2;}
