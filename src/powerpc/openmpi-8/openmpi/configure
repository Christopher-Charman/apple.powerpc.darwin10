            line="`grep WRAPPER_EXTRA_LIBS= $infile | cut -d= -f2-`"
                eval "line=$line"
                if test -n "$line"; then
                    orte_WRAPPER_EXTRA_LIBS="$orte_WRAPPER_EXTRA_LIBS $line"
                fi
