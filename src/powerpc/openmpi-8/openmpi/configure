    { echo "$as_me:$LINENO: checking if MCA component $framework:$component can compile" >&5
echo $ECHO_N "checking if MCA component $framework:$component can compile... $ECHO_C" >&6; }
    { echo "$as_me:$LINENO: result: yes" >&5
echo "${ECHO_T}yes" >&6; }

