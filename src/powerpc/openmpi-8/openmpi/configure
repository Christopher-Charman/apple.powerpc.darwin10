             fi
             str="line=\$${framework}_${component}_WRAPPER_EXTRA_LIBS"
             eval "$str"
             if test -n "$line" ; then
                 orte_WRAPPER_EXTRA_LIBS="$orte_WRAPPER_EXTRA_LIBS $line"
