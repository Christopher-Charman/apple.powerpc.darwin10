#include <sys/syscall.h>
#include <sys/epoll.h>
#include <unistd.h>
#include <stdlib.h>

int
epoll_create(int size)
{
	return (syscall(__NR_epoll_create, size));
}

int
main()
{
	int epfd;

	epfd = epoll_create(256);
	exit (epfd == -1 ? 1 : 0);
}
