echo $ECHO_N "checking for MCA component $framework:$component compile mode... $ECHO_C" >&6; }
    if test "$DIRECT_errmgr" = "$component" ; then
        { echo "$as_me:$LINENO: result: $compile_mode - direct" >&5
echo "${ECHO_T}$compile_mode - direct" >&6; }
