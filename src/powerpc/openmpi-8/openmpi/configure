                 opal_WRAPPER_EXTRA_LDFLAGS="$opal_WRAPPER_EXTRA_LDFLAGS $line"
             fi
             str="line=\$${framework}_${component}_WRAPPER_EXTRA_LIBS"
             eval "$str"
