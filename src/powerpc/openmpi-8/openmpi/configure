    # no F90 compiler.  If we have no f90 compiler, then just set a
    # bunch of defaults.
    if test "$OMPI_WANT_F90_BINDINGS" = "1"; then



    # Determine FORTRAN datatype size.
    # First arg is type, 2nd arg is config var to define

