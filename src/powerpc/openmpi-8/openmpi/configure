            line="`grep WRAPPER_EXTRA_LIBS= $infile | cut -d= -f2-`"
                eval "line=$line"
                if test -n "$line"; then
                    ompi_WRAPPER_EXTRA_LIBS="$ompi_WRAPPER_EXTRA_LIBS $line"
                fi
