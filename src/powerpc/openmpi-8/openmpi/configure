    else if (! ((aw%2)||(ax%2)||(ay%2)||(az%2))) fprintf(f, "%d\n", 2);
    else fprintf(f, "%d\n", 1);
    fclose(f);
}
#ifdef __cplusplus
}
#endif
EOF


