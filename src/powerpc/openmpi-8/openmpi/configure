#include <pthread.h>
$ompi_conftest_h

#ifdef __cplusplus
extern "C" {
#endif
void $ompi_ac_thread_fn()
{
  pthread_t th;
  pthread_create(&th, NULL, NULL, NULL);
  pthread_join(th, 0);
  pthread_attr_init(0);
  pthread_cleanup_push(0, 0);
  pthread_create(0,0,0,0);
  pthread_cleanup_pop(0);
}
#ifdef __cplusplus
}
#endif
EOF

