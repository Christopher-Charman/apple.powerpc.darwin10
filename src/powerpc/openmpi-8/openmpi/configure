  { echo "$as_me:$LINENO: checking for BPROC_API_VERSION" >&5
echo $ECHO_N "checking for BPROC_API_VERSION... $ECHO_C" >&6; }
        cat >conftest.$ac_ext <<_ACEOF
/* confdefs.h.  */
_ACEOF
cat confdefs.h >>conftest.$ac_ext
cat >>conftest.$ac_ext <<_ACEOF
/* end confdefs.h.  */
#include <sys/bproc.h>
int
main ()
{
