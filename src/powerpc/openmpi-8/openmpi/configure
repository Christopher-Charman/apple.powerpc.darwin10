             str="line=\$${framework}_${component}_WRAPPER_EXTRA_LIBS"
             eval "$str"
             if test -n "$line" ; then
                 ompi_WRAPPER_EXTRA_LIBS="$ompi_WRAPPER_EXTRA_LIBS $line"
