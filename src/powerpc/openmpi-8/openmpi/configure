    if test "$compile_mode" = "static"; then
        str="line=\$${framework}_${component}_WRAPPER_EXTRA_LDFLAGS"
             eval "$str"
             if test -n "$line" ; then
                 orte_WRAPPER_EXTRA_LDFLAGS="$orte_WRAPPER_EXTRA_LDFLAGS $line"
