                 fi

    else

    { echo "$as_me:$LINENO: checking if MCA component pml:cm can compile" >&5
echo $ECHO_N "checking if MCA component pml:cm can compile... $ECHO_C" >&6; }
    { echo "$as_me:$LINENO: result: no" >&5
echo "${ECHO_T}no" >&6; }

    # If this component was requested as the default for this
    # type, then abort.
    if test "$with_pml" = "cm" ; then
        { echo "$as_me:$LINENO: WARNING: MCA component \"cm\" failed to configure properly" >&5
