         lt_prog_compiler_static_works_CXX=yes
       fi
     else
       lt_prog_compiler_static_works_CXX=yes
     fi
   fi
   $RM conftest*
   LDFLAGS="$save_LDFLAGS"

fi
{ echo "$as_me:$LINENO: result: $lt_prog_compiler_static_works_CXX" >&5
