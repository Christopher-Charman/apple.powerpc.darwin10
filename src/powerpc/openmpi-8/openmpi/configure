echo "$as_me: WARNING: MCA component configure script told me to abort" >&2;}
            { { echo "$as_me:$LINENO: error: cannot continue" >&5
echo "$as_me: error: cannot continue" >&2;}
   { (exit 1); exit 1; }; }
