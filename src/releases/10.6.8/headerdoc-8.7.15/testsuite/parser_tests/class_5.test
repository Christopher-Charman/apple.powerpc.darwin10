	        <span class="keyword">const</span> <!-- a logicalPath="//test_ref/cpp/econst/char //test_ref/cpp/data/char" --><span class="var">char</span><!-- /a --> <span class="var">*</span><!-- a logicalPath="//test_ref/cpp/econst/inClassName //test_ref/cpp/data/inClassName" --><span class="var">inClassName</span><!-- /a -->, 
	        <span class="keyword">const</span> <!-- a logicalPath="//test_ref/cpp/econst/OSMetaClass //test_ref/cpp/data/OSMetaClass" --><span class="var">OSMetaClass</span><!-- /a --> <span class="var">*</span><!-- a logicalPath="//test_ref/cpp/econst/inSuperClass //test_ref/cpp/data/inSuperClass" --><span class="var">inSuperClass</span><!-- /a -->, 
	        <!-- a logicalPath="//test_ref/cpp/econst/unsigned //test_ref/cpp/data/unsigned" --><span class="var">unsigned</span><!-- /a --> <!-- a logicalPath="//test_ref/cpp/econst/int //test_ref/cpp/data/int" --><span class="var">int</span><!-- /a --> <!-- a logicalPath="//test_ref/cpp/econst/inClassSize //test_ref/cpp/data/inClassSize" --><span class="var">inClassSize</span><!-- /a -->);  
