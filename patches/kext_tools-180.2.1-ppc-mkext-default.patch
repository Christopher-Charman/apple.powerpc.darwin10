+            if (!hostArch || hostArch->cputype == CPU_TYPE_ANY) {
+                hostArch = NXGetLocalArchInfo();
+            }
+            if (hostArch && hostArch->cputype == CPU_TYPE_POWERPC) {
+                addArchForName(toolArgs, "ppc");
